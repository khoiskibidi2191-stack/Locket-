<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <!-- Cấu hình DNS Proxy -->
        <dict>
            <key>PayloadDescription</key>
            <string>Cấu hình DNS Proxy để kích hoạt Locket Gold</string>
            <key>PayloadDisplayName</key>
            <string>Locket Gold Free</string>
            <key>PayloadIdentifier</key>
            <string>com.phamkhoi.locketgold.dns</string>
            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>12345678-1234-1234-1234-1234567890AB</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>
                <!-- Thay link Server MITM của ông vào đây (nếu có), dưới đây là DNS Cloudflare làm mẫu -->
                <key>ServerURL</key>
                <string>https://1.1.1.1/dns-query</string>
            </dict>
        </dict>
    </array>
    <key>PayloadDisplayName</key>
    <string>Locket Gold Profile</string>
    <key>PayloadIdentifier</key>
    <string>com.phamkhoi.locketgold</string>
    <key>PayloadOrganization</key>
    <string>PhamKhoi (Khoi Chuot Bach)</string>
    <key>PayloadType</key>
    <string>Configuration</string>
    <key>PayloadUUID</key>
    <string>87654321-4321-4321-4321-BA0987654321</string>
    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
